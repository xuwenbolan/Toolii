ENV=dev
PROJECT_NAME=Toolii API
API_PREFIX=/api

# Comma-separated list
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=sqlite+aiosqlite:///../data/toolii.db
DB_ECHO=false

JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

GOOGLE_OAUTH_CLIENT_ID=

DOWNLOAD_SIGNING_SECRET=CHANGE_ME_TOO

RATE_LIMIT_ANON=10/minute
RATE_LIMIT_AUTH=20/minute

MAX_CONCURRENT_TASKS_PER_KEY=3

MAX_UPLOAD_IMAGE_MB=20
MAX_UPLOAD_PDF_MB=50
MAX_BATCH_FILES=20
MAX_BATCH_TOTAL_MB=100

FILE_STORAGE_DIR=../data/files
FILE_RETENTION_HOURS=24
DOWNLOAD_URL_TTL_SECONDS=3600
